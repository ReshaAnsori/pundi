// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Platform {
  id          Int          @id @default(autoincrement())
  code        String       @unique // "shopee" | "tiktok"
  name        String
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  products    Product[]
  commissions Commission[]
  syncRuns    SyncRun[]
}

model Product {
  id             Int             @id @default(autoincrement())
  platformId     Int
  externalId     String
  name           String
  price          Int? // rupiah
  commissionRate Float? // persen
  url            String?
  imageUrl       String?
  category       String?
  rating         Float?
  soldCount      Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  platform       Platform        @relation(fields: [platformId], references: [id])
  links          AffiliateLink[]
  score          ProductScore?

  @@unique([platformId, externalId])
}

model Content {
  id          Int               @id @default(autoincrement())
  title       String
  channel     String // "tiktok" | "instagram" | ...
  status      String            @default("draft") // draft | scheduled | published
  externalUrl String?
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  links       AffiliateLink[]
  schedules   PostingSchedule[]
}

model AffiliateLink {
  id          Int          @id @default(autoincrement())
  productId   Int
  contentId   Int?
  subId       String       @unique // pengikat komisi -> konten
  trackingUrl String
  createdAt   DateTime     @default(now())
  product     Product      @relation(fields: [productId], references: [id])
  content     Content?     @relation(fields: [contentId], references: [id])
  commissions Commission[]
}

model Commission {
  id                Int            @id @default(autoincrement())
  platformId        Int
  linkId            Int?
  orderExternalId   String
  productExternalId String?
  status            String // pending | valid | cancelled
  amount            Int // komisi, rupiah
  orderAmount       Int?
  orderedAt         DateTime
  settledAt         DateTime?
  raw               String? // payload mentah (JSON string)
  platform          Platform       @relation(fields: [platformId], references: [id])
  link              AffiliateLink? @relation(fields: [linkId], references: [id])

  @@unique([platformId, orderExternalId, productExternalId])
}

model SyncRun {
  id              Int       @id @default(autoincrement())
  platformId      Int
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  status          String // running | ok | failed
  recordsUpserted Int       @default(0)
  error           String?
  platform        Platform  @relation(fields: [platformId], references: [id])
}

model ProductScore {
  id        Int      @id @default(autoincrement())
  productId Int      @unique
  score     Float // skor komposit 0 - 100
  status    String   @default("new") // new | shortlisted | used | skipped
  notes     String?
  breakdown String? // JSON string: { commissionScore, soldScore, ratingScore, priceScore }
  scoredAt  DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PostingSchedule {
  id           Int      @id @default(autoincrement())
  contentId    Int
  channel      String // "tiktok" | "instagram" | "youtube" | "shopee_video"
  scheduledFor DateTime
  status       String   @default("pending") // "pending" | "ready_to_post" | "posted" | "skipped"
  reminderSent Boolean  @default(false)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  content      Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
}

